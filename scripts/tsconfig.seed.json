{
  "//": "Used only by scripts/generate-seed.mjs to compile the static catalog modules to plain JS so the seed can be generated from them rather than retyped. Not part of the app build.",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] },
    "rootDir": "../src",
    "noEmit": false,
    "declaration": false,
    "incremental": false,
    "isolatedModules": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": false
  },
  "include": [
    "../src/types/index.ts",
    "../src/data/deviceData.ts",
    "../src/data/mockData.ts",
    "../src/data/iphoneModels.ts",
    "../src/data/categoryMeta.ts",
    "../src/lib/partProduct.ts"
  ]
}
