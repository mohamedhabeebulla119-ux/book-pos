<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-transfer rules.

    The WebView's storage holds the customer's Supabase session (access and
    refresh tokens), so no app data may leave the device: not to cloud backup
    and not to a new phone during device-to-device setup. On Android 12+
    android:allowBackup="false" no longer stops device transfer, so every
    domain is excluded explicitly here. Android 11 and lower are covered by
    android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
